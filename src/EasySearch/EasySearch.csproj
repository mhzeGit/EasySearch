<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EasySearch</AssemblyName>
    <RootNamespace>EasySearch</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The WebView2 package also ships a WPF control whose WindowsBase reference clashes harmlessly; this app only uses WinForms. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasySearch.Core\EasySearch.Core.csproj" />
    <EmbeddedResource Include="Updating\ApplyUpdate.ps1" LogicalName="EasyTools.ApplyUpdate.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interface is plain HTML/CSS/JS, served to WebView2 from the output folder. -->
    <Content Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation lives in the WindowsDesktop targeting pack but is not one of its default
         references. The wildcard matches whichever pack version the installed SDK ships, so the
         build does not break when the SDK is updated. -->
    <Reference Include="$(NetCoreTargetingPackRoot)\Microsoft.WindowsDesktop.App.Ref\*\ref\net10.0\UIAutomationClient.dll" />
    <Reference Include="$(NetCoreTargetingPackRoot)\Microsoft.WindowsDesktop.App.Ref\*\ref\net10.0\UIAutomationTypes.dll" />
  </ItemGroup>

  <Target Name="WriteBuildUpdateManifest" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\WriteUpdateManifest.ps1&quot; -Directory &quot;$(TargetDir).&quot; -Product EasySearch -Version &quot;$(Version)&quot;" />
  </Target>
  <Target Name="WritePublishUpdateManifest" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\WriteUpdateManifest.ps1&quot; -Directory &quot;$(PublishDir).&quot; -Product EasySearch -Version &quot;$(Version)&quot;" />
  </Target>
</Project>
